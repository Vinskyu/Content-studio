#!/bin/sh
# Custom minimal Gradle wrapper runner
set -e

DIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"

# Main-Class is not guaranteed to be present in gradle-wrapper.jar, so launch the
# wrapper main class explicitly through the classpath instead of `java -jar`.
if [ -f "$WRAPPER_JAR" ] && command -v java >/dev/null 2>&1; then
    exec java -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
fi

if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi

if [ ! -f "$WRAPPER_JAR" ]; then
echo "Downloading gradle-wrapper.jar..."
mkdir -p "$DIR/gradle/wrapper"
curl -sSL "https://raw.githubusercontent.com/gradle/gradle/v8.7.0/gradle/gradle/wrapper/gradle-wrapper.jar" -o "$WRAPPER_JAR" || {
    echo "Error: Failed to obtain gradle-wrapper.jar and no gradle installation found."
    exit 1
}
fi

exec java -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
